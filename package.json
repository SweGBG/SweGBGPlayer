{
  "name": "swegbgplayer",
  "version": "2.0.0",
  "description": "SweGBGPlayer - media player with subtitle download and Music Grabber extension",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.swegbg.player",
    "productName": "SweGBGPlayer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "icon.png"
    ],
    "extraResources": [
      { "from": "tools/bin", "to": "tools/bin", "filter": ["yt-dlp.exe", "ffmpeg.exe"] }
    ],
    "fileAssociations": [
      { "ext": "mp3", "name": "MP3 Audio", "role": "Viewer" },
      { "ext": "wav", "name": "WAV Audio", "role": "Viewer" },
      { "ext": "ogg", "name": "OGG Audio", "role": "Viewer" },
      { "ext": "flac", "name": "FLAC Audio", "role": "Viewer" },
      { "ext": "aac", "name": "AAC Audio", "role": "Viewer" },
      { "ext": "m4a", "name": "M4A Audio", "role": "Viewer" },
      { "ext": "wma", "name": "WMA Audio", "role": "Viewer" },
      { "ext": "mp4", "name": "MP4 Video", "role": "Viewer" },
      { "ext": "mkv", "name": "MKV Video", "role": "Viewer" },
      { "ext": "webm", "name": "WebM Video", "role": "Viewer" },
      { "ext": "avi", "name": "AVI Video", "role": "Viewer" },
      { "ext": "mov", "name": "QuickTime Video", "role": "Viewer" },
      { "ext": "wmv", "name": "WMV Video", "role": "Viewer" },
      { "ext": "flv", "name": "FLV Video", "role": "Viewer" },
      { "ext": "m4v", "name": "M4V Video", "role": "Viewer" },
      { "ext": "ogv", "name": "OGV Video", "role": "Viewer" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "Lenn",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
